{"nodes": [{"id": "main_UltimateObsidianSyncPlugin", "label": "Ultimate Obsidian Sync Plugin", "file_type": "code", "source_file": "src/main.ts", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "main_RepositorySetupFlow", "label": "Repository Setup Flow (create/clone/init+push decision tree)", "file_type": "code", "source_file": "src/main.ts", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Credentials are persisted immediately at setup start so a plugin reload during slow OAuth/repo setup can restore the connection; rolled back to previous settings on failure. Clone-vs-init+push is decided by checking whether the remote has commits (repoHasCommits) instead of swallowing clone errors, so real auth/network failures stay visible."}, {"id": "main_AutoSyncEventFunnel", "label": "Auto-Sync Event Funnel (5s aggregation window)", "file_type": "code", "source_file": "src/main.ts", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All vault modify/create/delete/rename events funnel through one counter (blocked/filtered/enqueued) logged once per 5s window to avoid log flooding on mobile."}, {"id": "main_MobileVaultPathHandling", "label": "Mobile Vault Path Handling", "file_type": "code", "source_file": "src/main.ts", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mobile adapters may expose basePath even though their API expects vault-relative paths; an empty vaultPath makes isomorphic-git operate from the adapter root, never the exposed filesystem path."}], "edges": [{"source": "main_UltimateObsidianSyncPlugin", "target": "logger_DebugLogger", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/main.ts", "source_location": null, "weight": 1.0}, {"source": "main_UltimateOb